# Copy to .env.local and fill in your own values. Never commit real values.
# These variables are exposed to the browser build — do NOT put secrets here.
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-anon-key
DATABASE_URL=

# AI (server-side only). Deploy supabase/functions/ai-property and set these
# as Supabase Edge Function secrets. NEVER expose them via VITE_* variables
# or client code. The browser talks only to our Edge Function, never OpenAI.
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4.1-mini

# Notifications: set RESEND_API_KEY, NOTIFICATION_FROM_EMAIL, SITE_URL,
# CRON_SECRET as Supabase Edge Function secrets.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
SITE_URL=https://gharhub.site
CRON_SECRET=

# Google Maps browser key (restrict by production hostname).
VITE_GOOGLE_MAPS_API_KEY=

# Error monitoring
VITE_SENTRY_DSN=
VITE_APP_VERSION=